{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/MODEL-ID",
  "default_agent": "workflow-guide-agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "MODEL-ID": {
          "name": "Lokales Ollama-Modell"
        }
      }
    }
  },
  "permission": {
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "question": "allow",
    "task": "deny",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git reset*": "deny",
      "git clean*": "deny",
      "rm *": "deny",
      "sudo *": "deny",
      "git commit*": "deny",
      "git push*": "deny"
    },
    "webfetch": "ask",
    "websearch": "deny",
    "external_directory": "ask",
    "doom_loop": "ask"
  }
}
